# Copy to .env.local or run: npm run configure-oauth -- "YOUR_CLIENT_ID.apps.googleusercontent.com"
GPFC_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Optional but required for an in-extension Google account chooser.
# Create a Web application OAuth client and authorize:
# https://igacbcmbkglkglkindhcpmagafnboolj.chromiumapp.org/
GPFC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
